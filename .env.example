# Optional LLM generation. Without this key HAY Engine uses deterministic demo generation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Armenian-first TTS. Eleven v3 supports Armenian (HYE).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v3

# Future adapters
GOOGLE_CLOUD_PROJECT=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
