# Optional creative planning + scene image generation.
# Without this key HAY Engine uses deterministic demo storyboards and visual placeholders.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2

# Armenian-first TTS. Eleven v3 supports Armenian (HYE).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v3

# Future speech/video adapters
GOOGLE_CLOUD_PROJECT=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
HAY_VIDEO_PROVIDER=
HAY_VIDEO_API_KEY=
