# HAY Engine / Vercel environment template

# OpenAI — strategy, scripts, Armenian naturalization, creative planning and generated scene images.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MARKETING_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2

# HAY Armenian Language API.
# File transcription currently uses OpenAI STT, then HAY runs its own Armenian transcript correction layer.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_TRANSCRIPT_CORRECTION_MODEL=gpt-5.6-luna
OPENAI_TRANSLATE_MODEL=gpt-5.6-luna
# Provider-backed Studio language routes are account-gated in production by default.
# Keep false in production unless this is an intentionally public demo environment.
HAY_ALLOW_UNAUTHENTICATED_LANGUAGE_API=false
HAY_MAX_TRANSCRIBE_BYTES=26214400

# Public developer-facing HAY Language API V1.
# Requires the developer_api_keys + developer_api_usage schema from migration 007.
# Raw hay_live_* keys are returned once and only SHA-256 hashes are persisted.
# The API fails closed unless BOTH the enable flag and a positive per-key hourly request limit are configured.
HAY_DEVELOPER_API_ENABLED=false
HAY_DEVELOPER_API_HOURLY_REQUEST_LIMIT=0

# Armenian-first TTS — preferred custom/signature voices.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID_MALE=
ELEVENLABS_VOICE_ID_FEMALE=
ELEVENLABS_VOICE_ID_WESTERN=

# Armenian neural TTS fallback. HAY knows the official hy-AM voices:
# hy-AM-AnahitNeural (female) and hy-AM-HaykNeural (male).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Google AI / Veo 3.1. HAY uses Veo for text-free visual scenes; Armenian typography is overlaid separately.
GEMINI_API_KEY=
VEO_MODEL=veo-3.1-fast-generate-preview

# Optional Google Cloud speech / ASR evaluation. Chirp 3 supports hy-AM;
# its adapter is intentionally benchmark-planned rather than silently mixed into production routing.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=global

# Dedicated HAY Supabase project. Never reuse another product's database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY — never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Commercial core.
# Apply supabase/007_commercial_core.sql before setting this to true.
# When enabled, HAY refuses provider-cost operations for unauthenticated,
# inactive or over-limit accounts instead of silently exceeding the plan.
HAY_ENFORCE_PLANS=false

# Strong server-to-server secret for /api/billing/sync.
# The payment provider adapter/automation verifies its own webhook first,
# then calls HAY with Authorization: Bearer <this secret>.
HAY_BILLING_SYNC_SECRET=

# Provider-neutral hosted checkout links. They can point to Stripe Payment Links,
# Paddle, Lemon Squeezy or another HTTPS hosted checkout. A trusted signed webhook
# should update account_entitlements after payment; never trust the browser redirect.
HAY_CHECKOUT_CREATOR_URL=
HAY_CHECKOUT_GROWTH_URL=
HAY_CHECKOUT_BUSINESS_URL=
HAY_CHECKOUT_AGENCY_URL=

# TikTok developer app / Content Posting API.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://YOUR_DOMAIN/api/social/callback

# Google OAuth / YouTube Data API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR_DOMAIN/api/social/callback

# Meta app. Keep OAuth and token endpoints configurable because Meta product flows/versioning vary by approved app setup.
META_CLIENT_ID=
META_CLIENT_SECRET=
META_REDIRECT_URI=https://YOUR_DOMAIN/api/social/callback
META_OAUTH_URL=
META_TOKEN_URL=
# facebook or instagram
META_TOKEN_MODE=facebook

# Optional LinkedIn connector contract.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://YOUR_DOMAIN/api/social/callback

# Dedicated heavy workers. Keep secrets server-only.
RENDER_WORKER_URL=
RENDER_WORKER_SECRET=
PUBLISH_WORKER_URL=
PUBLISH_WORKER_SECRET=
