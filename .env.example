# HAY Engine / Vercel environment template

# OpenAI — strategy, scripts, Armenian naturalization, creative planning and generated scene images.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MARKETING_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2

# Armenian-first TTS — preferred custom/signature voices.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID_MALE=
ELEVENLABS_VOICE_ID_FEMALE=
ELEVENLABS_VOICE_ID_WESTERN=

# Armenian neural TTS fallback. HAY knows the official hy-AM voices:
# hy-AM-AnahitNeural (female) and hy-AM-HaykNeural (male).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Google AI / Veo 3.1. HAY uses Veo for text-free visual scenes; Armenian typography is overlaid separately.
GEMINI_API_KEY=
VEO_MODEL=veo-3.1-fast-generate-preview

# Optional Google Cloud speech / ASR evaluation (Chirp supports hy-AM).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=global

# Dedicated HAY Supabase project. Never reuse another product's database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY — never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# TikTok developer app / Content Posting API.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://YOUR_DOMAIN/api/social/callback

# Google OAuth / YouTube Data API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR_DOMAIN/api/social/callback

# Meta app. Keep OAuth and token endpoints configurable because Meta product flows/versioning vary by approved app setup.
META_CLIENT_ID=
META_CLIENT_SECRET=
META_REDIRECT_URI=https://YOUR_DOMAIN/api/social/callback
META_OAUTH_URL=
META_TOKEN_URL=
# facebook or instagram
META_TOKEN_MODE=facebook

# Optional LinkedIn connector contract.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://YOUR_DOMAIN/api/social/callback

# Dedicated heavy workers. Keep secrets server-only.
RENDER_WORKER_URL=
RENDER_WORKER_SECRET=
PUBLISH_WORKER_URL=
PUBLISH_WORKER_SECRET=
